# =============================================================================
# PUB LEADS — Environment Variables
# =============================================================================
#
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o .env — todos os valores abaixo são sensíveis.
#
# Classificação:
#   PUBLIC   — pode aparecer no cliente (prefixo NEXT_PUBLIC_ no Next.js)
#   SERVER   — apenas no servidor (API routes, server actions)
#   SECRET   — credencial, nunca chegar ao cliente
# =============================================================================

# --- PUBLIC — Can safely appear in the client (NEXT_PUBLIC_ prefix) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- SECRET — Supabase service role key (server-only, never expose to client) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- SECRET — Internal unlimited emails (comma-separated, server-only) ---
INTERNAL_UNLIMITED_EMAILS="email1@email.com,email2@email.com"

# --- SERVER — Turso / libSQL database ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
LEADS_DB_PROVIDER=turso

# --- SECRET — OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- SECRET — Google Maps / Places APIs ---
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- SECRET — Apify ---
APIFY_TOKEN=
APIFY_GOOGLE_MAPS_ACTOR_ID=compass/crawler-google-places
APIFY_INSTAGRAM_ACTOR_ID=apify/instagram-scraper
APIFY_GOOGLE_SEARCH_ACTOR_ID=apify/google-search-scraper
APIFY_MONTHLY_BUDGET_USD=5
APIFY_GOOGLE_MAPS_MAX_RESULTS_PER_RUN=50
APIFY_INSTAGRAM_MAX_RESULTS_PER_LEAD=3
APIFY_GOOGLE_SEARCH_MAX_PAGES_PER_LEAD=1

# --- PUBLIC — Checkout URLs ---
CHECKOUT_MENSAL_URL=/checkout/mensal
CHECKOUT_ANUAL_URL=/checkout/anual
CHECKOUT_VITALICIO_URL=/checkout/vitalicio

# --- SECRET — Billing provider ---
BILLING_PROVIDER=mock

# --- SECRET — Banco Inter PIX ---
INTER_ENV=sandbox
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERTIFICATE_BASE64=
INTER_PRIVATE_KEY_BASE64=
INTER_CERTIFICATE_PASSWORD=
INTER_PIX_KEY=

# --- SECRET — Webhook secrets (mandatory for production) ---
INTER_WEBHOOK_SECRET=
UTMIFY_WEBHOOK_SECRET=

# --- SERVER — Banco Inter API URLs ---
INTER_API_BASE_URL_SANDBOX=
INTER_API_BASE_URL_PRODUCTION=
INTER_OAUTH_URL_SANDBOX=
INTER_OAUTH_URL_PRODUCTION=
INTER_ACCOUNT_BRANCH=
INTER_ACCOUNT_NUMBER=
INTER_COMPANY_CNPJ=
INTER_CONTA_CORRENTE=
INTER_CONVENIO=
INTER_COBRANCA_CARTEIRA=

# --- SECRET — Tracking / UTMify ---
TRACKING_PROVIDER=none
UTMIFY_API_BASE_URL=
UTMIFY_API_TOKEN=

# --- PUBLIC — UTMify pixel (can appear in client) ---
UTMIFY_PIXEL_ID=
UTMIFY_STORE_ID=
UTMIFY_DEFAULT_CURRENCY=BRL